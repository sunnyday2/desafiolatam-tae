meta {
  name: 03 - Get Cliente by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/clients/{{clienteId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the same cliente that was created", function () {
    const c = res.getBody().data;
    expect(c).to.be.an("object");
    expect(String(c.id)).to.equal(String(bru.getVar("clienteId")));
    expect(c.name).to.equal(bru.getVar("clienteName"));
    expect(c.cuit).to.equal(bru.getVar("clienteCuit"));
  });

  test("payload exposes the core cliente fields", function () {
    const c = res.getBody().data;
    ["id", "name", "cuit", "email", "customer_code", "tax"].forEach(function (k) {
      expect(c).to.have.property(k);
    });
  });
}
