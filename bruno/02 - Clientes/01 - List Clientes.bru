meta {
  name: 01 - List Clientes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/clients?sort_direction=asc
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("response has a data array", function () {
    const body = res.getBody();
    expect(body).to.have.property("data");
    expect(body.data).to.be.an("array");
  });

  test("each cliente has the expected structure", function () {
    const data = res.getBody().data;
    if (data.length > 0) {
      const c = data[0];
      expect(c).to.have.property("id");
      expect(c).to.have.property("name");
      expect(c).to.have.property("cuit");
      expect(c).to.have.property("customer_code");
    }
  });
}
