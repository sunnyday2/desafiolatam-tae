meta {
  name: 04 - Update Articulo
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/products/{{articuloId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "{{articuloNameUpdated}}",
    "sku": "{{articuloSku}}",
    "line": {{lineId}},
    "category": {{categoryId}},
    "is_active": true,
    "sale_price": 1999,
    "cost_price": 800,
    "stock_quantity": 8
  }
}

script:pre-request {
  bru.setVar("articuloNameUpdated", bru.getVar("articuloName") + " (Actualizado)");
}

assert {
  res.status: eq 200
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("name reflects the update", function () {
    expect(res.getBody().data.name).to.equal(bru.getVar("articuloNameUpdated"));
  });

  test("sale_price reflects the update", function () {
    // API returns prices as strings (e.g. "1999.00"); compare numerically.
    expect(parseFloat(res.getBody().data.sale_price)).to.equal(1999);
  });

  test("id is unchanged after update", function () {
    expect(String(res.getBody().data.id)).to.equal(String(bru.getVar("articuloId")));
  });
}
