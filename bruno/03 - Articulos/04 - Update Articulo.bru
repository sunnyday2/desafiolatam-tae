meta {
  name: 04 - Modificar Articulo
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/products/{{articuloId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "{{articuloNameUpdated}}",
    "sku": "{{articuloSku}}",
    "line": {{lineId}},
    "category": {{categoryId}},
    "is_active": true,
    "sale_price": 1999,
    "cost_price": 800,
    "stock_quantity": 8
  }
}

script:pre-request {
// Setear la variable de entorno
  bru.setVar("articuloNameUpdated", bru.getVar("articuloName") + " (Actualizado)");
}

assert {
  res.status: eq 200
}

tests {
  test("status=200 (OK)", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("validar que la respuesta tiene mensaje igual a la variable seteada", function () {
    expect(res.getBody().data.name).to.equal(bru.getVar("articuloNameUpdated"));
  });

  test("validar que sale_price fue actualizado", function () {
    // convertir y comparar numeros.
    expect(parseFloat(res.getBody().data.sale_price)).to.equal(1999);
  });

  test("validar que el id del artículo es el mismo con cual fue actualizado", function () {
    expect(String(res.getBody().data.id)).to.equal(String(bru.getVar("articuloId")));
  });
}
