meta {
  name: 06 - Verify Articulo Deleted
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/products/{{articuloId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 404
}

tests {
  test("deleted articulo is no longer found (404)", function () {
    expect(res.getStatus()).to.equal(404);
  });
}
