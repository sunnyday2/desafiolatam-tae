meta {
  name: 01 - List Articulos
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/products?sort_direction=asc
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("response has a data array", function () {
    const body = res.getBody();
    expect(body).to.have.property("data");
    expect(body.data).to.be.an("array");
  });

  test("each articulo has the expected structure", function () {
    const data = res.getBody().data;
    if (data.length > 0) {
      const p = data[0];
      ["id", "name", "sku", "is_active", "line", "category"].forEach(function (k) {
        expect(p).to.have.property(k);
      });
    }
  });
}
