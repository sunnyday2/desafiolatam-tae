meta {
  name: 05 - Delete Articulo
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/products/{{articuloId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 204
}

tests {
  test("status is 204 No Content", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
