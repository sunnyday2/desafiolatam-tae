meta {
  name: 03 - Get Articulo by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/products/{{articuloId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the same articulo that was created", function () {
    const p = res.getBody().data;
    expect(p).to.be.an("object");
    expect(String(p.id)).to.equal(String(bru.getVar("articuloId")));
    expect(p.name).to.equal(bru.getVar("articuloName"));
    expect(p.sku).to.equal(bru.getVar("articuloSku"));
  });

  test("payload exposes the core articulo fields", function () {
    const p = res.getBody().data;
    ["id", "name", "sku", "is_active", "line", "category", "sale_price", "stock_quantity"].forEach(function (k) {
      expect(p).to.have.property(k);
    });
  });
}
