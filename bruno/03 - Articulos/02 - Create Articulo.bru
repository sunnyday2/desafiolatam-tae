meta {
  name: 02 - Crear Articulo
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "{{articuloName}}",
    "sku": "{{articuloSku}}",
    "line": {{lineId}},
    "category": {{categoryId}},
    "is_active": true,
    "sale_price": 1500,
    "cost_price": 800,
    "stock_quantity": 5
  }
}

script:pre-request {
  // Generar data para test que sean los valores unicos para cada ejecución
  const suffix = Date.now().toString().slice(-8);
  bru.setVar("articuloName", "Articulo API Bruno " + suffix);
  // SKU acepta solo números
  bru.setVar("articuloSku", ("9" + suffix + suffix).slice(0, 12));
}

script:post-response {
  // asignar la variable de articuloId para todas las peticiones
  const body = res.getBody();
  if (body && body.data && body.data.id) {
    bru.setVar("articuloId", body.data.id);
  }
}

assert {
  res.status: eq 201
  res.body.data.id: isDefined
}

tests {
  test("status=201 (Created)", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("respuesta contiene elemento data y es un objeto", function () {
    expect(res.getBody()).to.have.property("data");
    expect(res.getBody().data).to.be.an("object");
  });

  test("validar que la respuesta de creación del articulo tiene misma data con que fue actualizada", function () {
    const p = res.getBody().data;
    expect(p).to.have.property("id");
    expect(p.name).to.equal(bru.getVar("articuloName"));
    expect(p.is_active).to.equal(true);
    // comparamos los numeros de line y category con las variables del  entorno
    expect(Number(p.line)).to.equal(Number(bru.getEnvVar("lineId")));
    expect(Number(p.category)).to.equal(Number(bru.getEnvVar("categoryId")));
  });

  test("validar que propiedades line y category contienen name", function () {
    const p = res.getBody().data;
    expect(p).to.have.property("line_name");
    expect(p).to.have.property("category_name");
  });
}
